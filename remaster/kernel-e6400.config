# ==============================================================================
# kernel-e6400.config — fragmento de configuracion del kernel a la medida
# Black Hole Linux 8.0 · Dell Latitude E6400
#   CPU:  Core 2 Duo P8400 (Penryn, 2 nucleos, sin HT, 64-bit baseline)
#   GPU:  Intel GMA 4500MHD (GM45, i915)
#   RAM:  2 GiB DDR2  (zram obligatorio)
#   Red:  Ethernet Intel e1000e; WiFi segun tarjeta (iwlwifi/iwlegacy/b43/brcmsmac)
#   BIOS: Legacy A14 (no EFI)
# Base: x86_64_defconfig + este fragmento (merge_config.sh + olddefconfig).
# Objetivo: vmlinuz pequeno, arranque rapido, todo lo del E6400 integrado
# (los drivers raros quedan como modulos), sin virtualizacion ni GPUs ajenas.
# ==============================================================================

# --- Identidad y compresion ---
CONFIG_LOCALVERSION="-blackhole-e6400"
CONFIG_LOCALVERSION_AUTO=y
CONFIG_KERNEL_ZSTD=y
CONFIG_DEFAULT_HOSTNAME="blackhole"

# --- Escritorio responsivo en 2 GiB ---
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_HZ_250=y
CONFIG_NR_CPUS=4
CONFIG_HIGHMEM4G=y
CONFIG_TRANSPARENT_HUGEPAGE_NEVER=y

# --- Graficos: solo Intel clasicos ---
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FB_VESA=y
CONFIG_DRM_FBDEV_EMULATION=y
# CONFIG_DRM_RADEON is not set
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_VMWGFX is not set
# CONFIG_DRM_GMA500 is not set

# --- Red cableada ---
CONFIG_E1000E=y

# --- WiFi: todas las candidatas del E6400 como modulos ---
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_IWLWIFI=m
CONFIG_IWLEGACY=m
CONFIG_IWL4965=m
CONFIG_IWL3945=m
CONFIG_B43=m
CONFIG_B43LEGACY=m
CONFIG_BRCMSMAC=m
CONFIG_ATH9K=m
CONFIG_RTL8XXXU=m

# --- Audio ---
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_ANALOG=y

# --- Live USB/CD y sistemas de archivos ---
CONFIG_BLK_DEV_LOOP=y
CONFIG_ISO9660_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_GZIP=y
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_FUSE_FS=m

# --- Memoria en 2 GiB ---
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=m
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZSWAP=y
CONFIG_MEMCG=y

# --- Energia/portatil (ACPI intacto, sin trucos) ---
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_VIDEO=m
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_THERMAL=y
CONFIG_X86_THERMAL_VECTOR=y

# --- Entrada retro-gaming ---
CONFIG_INPUT_JOYDEV=m
CONFIG_JOYSTICK_XPAD=m
CONFIG_HIDRAW=y

# --- Quitar peso inutil en el E6400 ---
# CONFIG_KVM is not set
# CONFIG_KVM_INTEL is not set
# CONFIG_KVM_AMD is not set
# CONFIG_HYPERVISOR_GUEST is not set
# CONFIG_PARAVIRT is not set
# CONFIG_BT is not set
# CONFIG_STAGING is not set
# CONFIG_FPGA is not set
# CONFIG_SOUNDWIRE is not set
# CONFIG_XEN is not set

# --- Compilacion ligera (sin debug info ni BTF) ---
CONFIG_DEBUG_INFO_NONE=y
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
CONFIG_MODULE_COMPRESS_ZSTD=y
